<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Fallback for user-entered hosts only: a self-hosted Jellyfin, Seerr or
         *arr instance may be plain HTTP or fronted by a private CA the device
         owner installed. Their hostnames are not knowable at build time, so
         they can only be covered here. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- First-party / fixed endpoints. These carry account tokens, OAuth
         codes and crash payloads, and by construction never
         live behind a private CA. System anchors only.
         Every hard-coded https:// host in lib/ must appear here.
         Pinned by test/android/network_security_config_test.dart. -->
    <domain-config>
        <!-- api.trakt.tv incl. /oauth/device/*, /oauth/token
             (lib/services/trackers/trakt/trakt_constants.dart). -->
        <domain includeSubdomains="true">trakt.tv</domain>
        <!-- TMDB artwork (lib/services/catalog/seerr_catalog_source.dart:163). -->
        <domain includeSubdomains="true">image.tmdb.org</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
